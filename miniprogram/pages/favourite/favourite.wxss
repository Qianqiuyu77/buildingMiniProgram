.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  padding: 20rpx;
  background-color: white;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card {
  display: flex;
  flex-direction: column;
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-img {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.card-content {
  padding: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
}

.card-category {
  font-size: 26rpx;
  color: gray;
  margin-top: 10rpx;
}

.remove-btn {
  background-color: #ff4d4f;
  color: white;
  text-align: center;
  padding: 10rpx;
  border-radius: 0 0 20rpx 20rpx;
  font-size: 28rpx;
}
