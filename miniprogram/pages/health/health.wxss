page{
  background: linear-gradient(#aed5f7, #f8e6ad); /* 默认从上到下渐变 */
}

.mainPage {
  height: 89vh;
  width: 85vw;
  margin: 70rpx auto 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.topContainer{
  display: flex;
  align-items: center;
  justify-content: flex-start;
 }
 
 .logo{
 width: 85rpx;
 height: 90rpx;
 margin-left: 50rpx;
 }

 /* 搜索框 */
.custom-search {
  position: relative;
  width: 100%;
  max-width: 450rpx;
  margin: 10px auto;
  background-color: #dbebf7;
  border-radius: 25px;
  padding: 7px 15px;
  display: flex;
  align-items: center;
  box-shadow: -2rpx 10rpx 20rpx rgba(0, 0, 0, 0.1), 0rpx 5rpx 10rpx rgba(0, 0, 0, 0.05);
}

.custom-search input {
  border: none;
  outline: none;
  width: 100%;
  background: transparent;
  font-size: 16px;
}

.searchIconContainer{
  position: absolute;
  right: 15px;
  z-index: 100;
}
.search-icon {
  width: 90rpx;
  height: 90rpx;

}

.container{
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, 1fr);
  align-content: start; /* 让所有内容从顶部对齐 */
  gap: 30rpx;
}

.item{
  height: 300rpx;
}
.longItem{
  grid-column: span 2; /* 让这个元素占满两列 */
  height: 93rpx;
}
.item image{
  width: 100%;
  height: 100%;
}

.longItem image{
  width: 100%;
  height: 100%;
}