<view class="topContainer">
  <image class="logo" src="../../images/logo(1).png" />
  <view class="custom-search">
    <input type="text" />
    <image class="search-icon" src="../../images/10.png" />
  </view>
</view>
  <scroll-view scroll-y class="container">
    <view class="article" wx:for="{{mainInfo}}" wx:if="{{item.category === category}}"  wx:key="index" bind:tap="goToMessage" data-url="{{item.jumpUrl}}">
      
      <image  class="articleImg" src="{{item.imgUrl}}"  mode="" />
      <view  class="context">
        <!-- <view class="category">{{item.category}}</view> -->
        <view class="title">{{item.title}}</view>
        <view class="intr"></view>
        <view class="detail">{{item.introduce}}</view>
        <view class="writer">{{item.writer}}</view>
      </view>

    </view>
    <view class="article" wx:for="{{mainInfo}}" wx:if="{{item.category === category}}"  wx:key="index" bind:tap="goToMessage" data-url="{{item.jumpUrl}}">
      
      <image  class="articleImg" src="{{item.imgUrl}}"  mode="" />
