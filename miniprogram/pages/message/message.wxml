<view class="topContainer">
  <image class="logo" src="../../images/logo(1).png" />
  <view class="custom-search" >
    <input type="text" bindinput="inputSearch" value="{{searchValue}}" bindconfirm="onSearch"/>
    <view class="searchIconContainer" bind:tap="onSearch">
      <image class="search-icon"  src="../../images/10.png" />
    </view>
  
  </view>
</view>
  <scroll-view scroll-y class="container">
    <view class="article" wx:for="{{mainInfo}}"   wx:key="index" bind:tap="goToMessage" data-url="{{item.jumpUrl}}"
    data-qrcode="{{item.QRCode}}"
    >
      
      <image  class="articleImg" src="{{item.imgUrl}}"  mode="" />
      <view  class="context">
        <!-- <view class="category">{{item.category}}</view> -->
        <view class="title">{{item.title}}</view>
        <view class="intr"></view>
        <view class="detail">{{item.introduce}}</view>
        <view class="writer">{{item.writer}}</view>
        <view class="favouritecontainer">
  <!-- 收藏按钮 -->
  <view class="favouriteIcon" catchtap="onFavouriteClick" data-index="{{index}}" data-messageid="{{item._id}}">
    <view

    ></view>
    <image class="favImg" wx:if="{{item.isFavourite}}" src="../../images/收藏后.png" mode=""/>
    <image class="favImg" wx:else src="../../images/收藏前.png" mode=""/>


    <view class="star" wx:if="{{ item.showStars }}">
      <block wx:for="{{stars}}" wx:key="index">
        <view
          class="star-item"
          style="top: {{item.top}}rpx; left: {{item.left}}rpx; animation-delay: {{item.delay}}s"
        >⭐</view>
      </block>
    </view>
  </view>
</view>
      </view>

    </view>
  </scroll-view>

  <view class="overlay" wx:if="{{isOverlayVisible}}">
  <view class="tips">
  长按识别商家小程序
  </view>
  <view class="content">
    <image class="qrcodeImg" show-menu-by-longpress="true" src="{{qrcode}}" mode=""/>
  </view>
  <button class="close-btn" bindtap="closeOverlay">X</button>
</view>