<!-- pages/chat/chat.wxml -->
<view class="container">
  <!-- 聊天内容区域 -->
  <scroll-view class="chat-area" scroll-y scroll-with-animation>
    <block wx:for="{{messages}}" wx:key="index">
      <!-- 用户消息 -->
      <view wx:if="{{item.isUser}}" class="user-message">
        <image class="avatar" src="/images/4.png"/>
        <view class="message-bubble user">
          <text>{{item.content}}</text>
        </view>
      </view>

      <!-- AI消息 -->
      <view wx:else class="ai-message">
        <image class="avatar" src="/images/AI咨询.png"/>
        <view class="message-bubble ai" style="color: #fff; background-color: #6c9bff;">
          <text>{{item.content}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input 
      class="input" 
      placeholder="请输入您的问题..." 
      disabled
      placeholder-class="placeholder"
      bindinput="inputChange"
      value="{{inputValue}}"
    />
    <button class="send-btn" bindtap="sendMessage">发送</button>
  </view>
</view>