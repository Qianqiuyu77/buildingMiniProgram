.topContainer{
  position: absolute;
  top: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
 }

 .logo{
  width: 85rpx;
  height: 90rpx;
  margin-left: 50rpx;
  }

  /* 搜索框 */
.custom-search {
  position: relative;
  width: 100%;
  max-width: 450rpx;
  margin: 10px auto;
  background-color: #dbebf7;
  border-radius: 25px;
  padding: 7px 15px;
  display: flex;
  align-items: center;
  box-shadow: -2rpx 10rpx 20rpx rgba(0, 0, 0, 0.1), 0rpx 5rpx 10rpx rgba(0, 0, 0, 0.05);
}

.custom-search input {
  border: none;
  outline: none;
  width: 100%;
  background: transparent;
  font-size: 16px;
}
.searchIconContainer{
  position: absolute;
  right: 15px;
  z-index: 100;
}
.search-icon {
  width: 90rpx;
  height: 90rpx;

}

/* 地图容器样式 */
.map-container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 自定义标记点样式 */
.custom-marker {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marker-icon {
  width: 100%;
  height: 100%;
  animation: pulse 1.5s infinite;
}

/* 信息窗口样式 */
.info-window {
  position: absolute;
  bottom: 200rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transform: translateY(0);
  opacity: 1;
  transition: all 0.3s ease;
  z-index: 999999;
  display: flex;
  pointer-events: auto;
}

.info-window.hidden {
  transform: translateY(120%);
  opacity: 0;
  pointer-events: none;
}

.window-title {
  width: 400rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  white-space: nowrap; /* 不换行 */
  text-overflow: ellipsis; /* 省略号 */
}

.window-desc {
  width: 500rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap; /* 不换行 */
  text-overflow: ellipsis; /* 省略号 */
}

.window-close{
  position: absolute;
  background-color: #666;
  right: 20rpx;
  top: 10rpx;
  color: #fff;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 25rpx;
}

.window-img{
  width: 150rpx;
  height: 150rpx;
}

.window-img image{
  width: 100%;
  height: 100%;
}
.window-info{
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;

}
@keyframes handanimate {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}
.window-navBtn{
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  width: 50rpx;
  height: 50rpx;
  background-color: #aed5f7;
  border-radius: 50%;
}

.window-navBtn image{
  width: 100%;
  height: 100%;
}

.window-hand {
  position: absolute;
  bottom: 30rpx;
  right: 150rpx;
  width: 50rpx;
  height: 50rpx;
  animation: handanimate 1s infinite ease-in-out;
}

.window-hand image{
  width: 100%;
  height: 100%;
}

/* 控制按钮组 */
.controls {
  background-color: red;
  position: absolute;
  top: 400rpx;
  right: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 999999;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 加载提示 */
.loading-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
}

/* 动画效果 */
@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.8; }
}