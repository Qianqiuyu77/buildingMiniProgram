
page{
  background: linear-gradient(#aed5f7, #f8e6ad); /* 默认从上到下渐变 */
}

.topContainer{
 display: flex;
 align-items: center;
 justify-content: flex-start;
}

.logo{
width: 85rpx;
height: 90rpx;
margin-left: 50rpx;
}

.mainPage {
  height: 89vh;
  width: 85vw;
  margin: 30rpx auto 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.leftPage{
  width: 48.5%;
  height: 100%;
}

.rightPage{
  padding-top: 20rpx;
  width: 48.5%;
  height: 100%;
}

.modleBox{
  position: relative;
  width: 100%;
  background-color: #fff;
  height: 20rpx;
  margin-bottom: 35rpx;
  border-radius: 30rpx;
  box-shadow: -2rpx 10rpx 20rpx rgba(0, 0, 0, 0.1), 0rpx 5rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.quarterCircle {
  position: absolute;
  bottom: 0; /* 放置在左下角 */
  left: 0; /* 放置在左边 */
  width: 120rpx; /* 圆的半径 */
  height: 120rpx; /* 圆的半径 */
  background-color: #f8f5da; /* 圆的颜色，可以根据需要调整 */
  border-top-right-radius: 100rpx; /* 创建四分之一圆 */
  border-bottom-left-radius: 30rpx; /* 创建四分之一圆 */
}

.leftTopquarterCircle {
  position: absolute;
  top: 0; /* 放置在左下角 */
  left: 0; /* 放置在左边 */
  width: 180rpx; /* 圆的半径 */
  height: 240rpx; /* 圆的半径 */
  background-color: #dae6e0; /* 圆的颜色，可以根据需要调整 */
  border-bottom-right-radius: 180rpx; /* 创建四分之一圆 */
  border-top-left-radius: 30rpx; /* 创建四分之一圆 */
}

.rightTopquarterCircle {
  position: absolute;
  top: 0; /* 放置在左下角 */
  right: 0; /* 放置在左边 */
  width: 120rpx; /* 圆的半径 */
  height: 120rpx; /* 圆的半径 */
  background-color: #f8f5da; /* 圆的颜色，可以根据需要调整 */
  border-bottom-left-radius: 100rpx; /* 创建四分之一圆 */
  border-top-right-radius: 30rpx; /* 创建四分之一圆 */
}



.tiltedBox {
  width: 260rpx;
  height: 260rpx;
  background-color: #fff;
  margin-left: 20rpx;
  margin-top: 20rpx;
  border-radius: 30rpx;
  transform: rotate(15deg); /* 顺时针旋转 30 度 */
  transform-origin: center; /* 设置旋转的中心点 */
  background-color: #c8d8cd;
  box-shadow: -2rpx 10rpx 20rpx rgba(0, 0, 0, 0.1), 0rpx 5rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.modleIcon {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 100rpx;
  height: 100rpx;
  z-index: 3;
}

.womanImg{
  position: absolute;
  bottom: -20rpx;
  left: 85rpx;
  width: 150rpx;
  height: 130rpx;
  object-fit: contain; /* 确保图片缩放时不变形 */
}

.caseImg {
  position: absolute;
  bottom: 5rpx;
  left: 50rpx;
  width: 230rpx;
  height: 180rpx;
  object-fit: contain; /* 确保图片缩放时不变形 */
}

.ModleText{
  font-weight: 400;
  position: absolute;
  top: 25rpx;
  left: 130rpx;
}
 
.ModleTitle{
  font-size: 28rpx;
  text-shadow: 4rpx 4rpx 6rpx rgba(0, 0, 0, 0.5); /* 更大的阴影和更深的颜色 */
}

.ModleEnglish{
  font-size: 23rpx;
  text-shadow: 3rpx 3rpx 5rpx rgba(0, 0, 0, 0.4); /* 适度增强阴影效果 */
}

.CenterText{
  font-weight: 500;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
}
 
.CenterTitle {
  font-size: 36rpx;
  text-shadow: 4rpx 4rpx 6rpx rgba(0, 0, 0, 0.5); /* 更大的阴影和更深的颜色 */
}

.CenterEnglish {
  font-size: 23rpx;
  text-shadow: 3rpx 3rpx 5rpx rgba(0, 0, 0, 0.4); /* 适度增强阴影效果 */
}

.ScienceTitle{
  font-size: 28rpx;
  text-shadow: 4rpx 4rpx 6rpx rgba(0, 0, 0, 0.5); /* 更大的阴影和更深的颜色 */
}

/* 搜索框 */
.custom-search {
  position: relative;
  width: 100%;
  max-width: 450rpx;
  margin: 10px auto;
  background-color: #dbebf7;
  border-radius: 25px;
  padding: 7px 15px;
  display: flex;
  align-items: center;
  box-shadow: -2rpx 10rpx 20rpx rgba(0, 0, 0, 0.1), 0rpx 5rpx 10rpx rgba(0, 0, 0, 0.05);
}

.custom-search input {
  border: none;
  outline: none;
  width: 100%;
  background: transparent;
  font-size: 16px;
}

.searchIconContainer{
  position: absolute;
  right: 15px;
  z-index: 100;
}
.search-icon {
  width: 90rpx;
  height: 90rpx;

}

/* 半透明蒙层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3); /* 半透明背景 */
  z-index: 99999;
}

/* 内容区域 */
.content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  height: 45%;
  background-color: white;
  border-radius: 10px;
  overflow: hidden;
}

/* 关闭按钮 */
.close-btn {
  z-index: 1000;
  position: absolute;
  bottom: 310rpx;
  right: 350rpx;
  background-color: #939393;
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 40rpx;
  height: 50rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-container {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #8ec5fc 0%, #aed5f7 100%);
  position: relative;
  overflow: hidden;
}

/* 新增四角装饰 */
.corner-decor {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  z-index: 2;
}
.top-left { top: 30rpx; left: 30rpx; border-right: none; border-bottom: none; }
.top-right { top: 30rpx; right: 30rpx; border-left: none; border-bottom: none; }
.bottom-left { bottom: 30rpx; left: 30rpx; border-right: none; border-top: none; }
.bottom-right { bottom: 30rpx; right: 30rpx; border-left: none; border-top: none; }

/* 优化标题样式 */
.swiper-title {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  font-size: 38rpx;  /* 稍微调大字号 */
  font-weight: bold;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 8rpx rgba(0, 0, 0, 0.5);
  padding: 16rpx 30rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 12rpx;
  max-width: 60%;
  line-height: 1.4;
}

/* 标题左侧装饰条 */
.title-decoration {
  position: absolute;
  left: 20rpx;
  top: 40rpx;
  height: 60rpx;
  width: 6rpx;
  background: #ffd700;
  border-radius: 3rpx;
}

/* 优化时间样式 */
.swiper-time {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  font-size: 28rpx;
  color: #f0f0f0;
  opacity: 0.9;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: rgba(0,0,0,0.15);
  border-radius: 8rpx;
}

/* 时间图标 */
.time-icon {
  width: 24rpx;
  height: 24rpx;
  background: url('data:image/svg+xml;base64,') no-repeat center;
  background-size: contain;
  margin-right: 10rpx;
}

/* 优化图片样式 */
.swiper-image {
  position: absolute;
  bottom: 80rpx;
  right: 50rpx;
  width: 360rpx;
  height: 420rpx;
  object-fit: cover;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.3s ease-in-out;
  border: 4rpx solid rgba(255,255,255,0.8);  /* 新增边框 */
}

/* 新增底部装饰线 */
.bottom-decoration {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  width: 60%;
  height: 2rpx;
  background: rgba(255,255,255,0.3);
  transform: translateX(-50%);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* 悬停效果优化 */
.swiper-image:hover {
  transform: scale(1.05) rotateZ(1deg);
  box-shadow: 0 15rpx 30rpx rgba(0, 0, 0, 0.3);
}
/* 进度点 */
.progress-dots {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.7);
  margin: 0 5rpx;
}

.dot.active {
  background-color: #fff;
}