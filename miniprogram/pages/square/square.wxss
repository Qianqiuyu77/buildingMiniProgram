  margin-top: 30rpx;
  border: 3rpx solid #8e8e8e;
  border-radius: 20rpx;
  width: 580rpx;
}

.text-ti {
  font-size: 23rpx;
  margin: 20rpx 0 20rpx 10rpx;
  padding-left: 10rpx;
  color: black;
}

.input1 {
  margin:  auto 20rpx;
}
.vantbutton{
  position: absolute;
  background-color: #8e8e8e;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  border-radius: 20rpx;
  width: 80rpx;
  height: 80rpx;
  right: 0;
  font-size: 23rpx;
}

.addPlIcon{
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 100rpx;
 color: white;
 position: fixed;
 border-radius: 50%;
 bottom: 180rpx;
 right: 100rpx;
 width: 100rpx;
 height: 100rpx;
 background-color:#aed5f7;
}
.icontext{
  margin-bottom: 20rpx;
}

.dropdown{
  width: 15%; 
}

.roate{
  transform: rotate(-180deg);
}

.dropImage{
  width: 100%;
  height: 30rpx;
  transition: transform 0.3s ease-in-out; 
}

.dropImage image{
  width: 100%;
  height: 100%;
}

/* 触发按钮 */
.dropdown-button {
  padding: 10px;
  color: black;
  text-align: center;
  border-radius: 5px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 箭头图标 */
.arrow {
  margin-left: 10px;
  transition: transform 0.3s ease;
}
.arrow-down {
  transform: rotate(0deg);
}
.arrow-up {
  transform: rotate(180deg);
}

/* 下拉菜单 */
.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 20rpx;
  width: 20%;
  background: white;
  border: 1px solid #ddd;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  border-radius: 5px;
  z-index: 10;
  overflow: hidden;
}

/* 菜单项 */
.dropdown-item {
  padding: 10px;
  text-align: center;
  border-bottom: 1px solid #f0f0f0;
  cursor: pointer;
}
.dropdown-item:last-child {
  border-bottom: none;
}
.dropdown-item:hover {
  background: #f5f5f5;
}

.resetButton{
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.resetButton image{
  width: 100%;
  height: 100%;
}
